{
  "name": "jingqing",
  "description": "鲸晴 JingQing - 让 DeepSeek Harness 纯文本模型也能识图:MiMo 识别 + 所选模型推理(静态插件包,重启永久生效)",
  "version": "1.1.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alnita-M/jingqing.git"
  },
  "homepage": "https://github.com/Alnita-M/jingqing",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "vision",
    "image-recognition",
    "mimo",
    "识图"
  ],
  "bin": {
    "jingqing-install": "install.mjs"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
